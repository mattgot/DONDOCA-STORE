{
  "expo": {
    "name": "estoqueapp",
    "slug": "estoqueapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.caio_richard_de_abreu.estoqueapp",
      "permissions": [
        "READ_INTERNAL_STORAGE",
        "WRITE_INTERNAL_STORAGE"
      ]
    },
    "web": {},
    "plugins": [
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "34b27e07-2732-4fe4-9eb8-a8308b741b60"
      }
    }
  }
}
